---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-zinc-950 border-t border-zinc-800/80 pt-14 pb-28 md:pb-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="space-y-3 max-w-md">
        <a href="/" class="inline-flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-700/80 flex items-center justify-center text-emerald-400">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
              <polyline points="16 7 22 7 22 13"></polyline>
            </svg>
          </div>
          <span class="font-bold tracking-tight text-white text-base">
            Elevate<span class="text-emerald-400">Growth</span>
          </span>
        </a>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Infrastruktur akuisisi prospek B2B dan validasi penawaran berkecepatan tinggi untuk pertumbuhan bisnis yang terukur.
        </p>
      </div>

      <nav class="flex flex-wrap items-center gap-6 text-sm text-zinc-400" aria-label="Navigasi bawah">
        <a href="#solusi" class="hover:text-white transition-colors">Solusi</a>
        <a href="#keunggulan" class="hover:text-white transition-colors">Keunggulan</a>
        <a href="#harga" class="hover:text-white transition-colors">Paket Investasi</a>
        <a href="#testimoni" class="hover:text-white transition-colors">Hasil Klien</a>
        <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
        <a href="#lead-form" class="hover:text-white transition-colors">Registrasi</a>
      </nav>
    </div>

    <div class="pt-8 border-t border-zinc-800/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-zinc-400">
      <div>
        &copy; {currentYear} {siteConfig.name}. Engineered by{' '}
        <a
          href="https://ahmadandhikaharirie.my.id"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-200 hover:text-emerald-400 underline underline-offset-4 transition-colors"
        >
          {siteConfig.author}
        </a>.
      </div>
      <div class="font-mono text-[11px] text-zinc-400">
        Astro 5 · Tailwind v4 · Serverless Sheets Pipeline
      </div>
    </div>
  </div>
</footer>
