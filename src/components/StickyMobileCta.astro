---
import { ArrowRight, MessageSquare } from 'lucide-astro';
import { siteConfig } from '../config/site';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || siteConfig.whatsappNumber;
const whatsappText = encodeURIComponent('Halo tim ElevateGrowth, saya ingin bertanya mengenai slot Executive Workshop & akselerasi konversi B2B.');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappText}`;
---

<div class="md:hidden fixed bottom-0 inset-x-0 z-40 border-t border-zinc-800 bg-zinc-950/95 backdrop-blur-md px-4 py-3">
  <div class="grid grid-cols-5 gap-2.5">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Konsultasi cepat melalui WhatsApp"
      class="col-span-2 inline-flex items-center justify-center gap-2 px-3 py-2.5 rounded-lg bg-zinc-900 border border-zinc-700 text-zinc-200 font-semibold text-xs hover:bg-zinc-800 transition-colors"
    >
      <MessageSquare class="w-4 h-4 text-emerald-400" />
      <span>Chat WA</span>
    </a>
    <a
      href="#lead-form"
      aria-label="Lompat ke formulir pendaftaran"
      class="col-span-3 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-emerald-500 text-zinc-950 font-bold text-xs hover:bg-emerald-400 transition-colors"
    >
      <span>Amankan Slot</span>
      <ArrowRight class="w-4 h-4" />
    </a>
  </div>
</div>
