---
import { siteConfig } from '../config/site';
import { PACKAGE_LABELS, VALID_PACKAGES } from '../utils/validation';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || siteConfig.whatsappNumber;
const sandboxSheetUrl = import.meta.env.PUBLIC_SANDBOX_SHEET_URL || siteConfig.defaultSandboxSheetUrl;
---

<section id="lead-form" class="py-16 sm:py-24 border-b border-zinc-200">
  <div class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 space-y-6">
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-zinc-950 leading-[1.12]">
          Konsultasikan proyek landing page Anda.
        </h2>

        <p class="text-zinc-600 text-sm sm:text-base leading-relaxed">
          Silakan isi informasi singkat di samping. Data pendaftaran akan otomatis masuk ke spreadsheet Google Sheets kami dan Anda dapat melanjutkan obrolan langsung via WhatsApp.
        </p>

        <div class="pt-6 border-t border-zinc-200 space-y-2 text-xs text-zinc-500">
          <div class="font-semibold text-zinc-800">Privasi Data &amp; Demonstrasi</div>
          <p class="leading-relaxed">
            Pada demo publik ini, sebagian digit nomor telepon dan email disensor otomatis demi keamanan privasi Anda.
          </p>
          <div>
            <a
              href={sandboxSheetUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-900 underline underline-offset-4 hover:text-zinc-600 font-medium"
            >
              Lihat spreadsheet sandbox publik &rarr;
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div
          id="lead-form-wrapper"
          data-whatsapp={whatsappNumber}
          class="p-6 sm:p-8 lg:p-10 rounded-xl bg-white border border-zinc-200 shadow-sm"
        >
          <form id="elevate-lead-form" class="space-y-4" novalidate>
            <div class="hidden" aria-hidden="true">
              <label for="company_fax">Company Fax</label>
              <input type="text" id="company_fax" name="company_fax" tabindex="-1" autocomplete="off" />
            </div>

            <input type="hidden" id="utm_source" name="utmSource" value="direct" />
            <input type="hidden" id="utm_medium" name="utmMedium" value="none" />
            <input type="hidden" id="utm_campaign" name="utmCampaign" value="organic" />
            <input type="hidden" id="referrer_url" name="referrer" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="fullName" class="block text-xs font-medium text-zinc-700">
                  Nama Lengkap
                </label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  placeholder="Budi Santoso"
                  autocomplete="name"
                  class="w-full px-3.5 py-2.5 rounded-md bg-[#faf9f6] border border-zinc-300 text-sm text-zinc-900 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors"
                />
              </div>

              <div class="space-y-1.5">
                <label for="phone" class="block text-xs font-medium text-zinc-700">
                  Nomor WhatsApp
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="081234567890"
                  autocomplete="tel"
                  class="w-full px-3.5 py-2.5 rounded-md bg-[#faf9f6] border border-zinc-300 text-sm text-zinc-900 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="email" class="block text-xs font-medium text-zinc-700">
                  Email Aktif
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="budi@email.com"
                  autocomplete="email"
                  class="w-full px-3.5 py-2.5 rounded-md bg-[#faf9f6] border border-zinc-300 text-sm text-zinc-900 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors"
                />
              </div>

              <div class="space-y-1.5">
                <label for="packageId" class="block text-xs font-medium text-zinc-700">
                  Pilihan Paket
                </label>
                <select
                  id="packageId"
                  name="packageId"
                  required
                  class="w-full px-3.5 py-2.5 rounded-md bg-[#faf9f6] border border-zinc-300 text-sm text-zinc-900 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors"
                >
                  {VALID_PACKAGES.map((pkgId) => (
                    <option value={pkgId} selected={pkgId === 'landing-page-bisnis'}>
                      {PACKAGE_LABELS[pkgId]}
                    </option>
                  ))}
                </select>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="notes" class="block text-xs font-medium text-zinc-700">
                Kebutuhan / Rencana Halaman (Opsional)
              </label>
              <textarea
                id="notes"
                name="notes"
                rows="3"
                placeholder="Ceritakan singkat produk, event, atau bisnis yang ingin Anda buatkan landing page..."
                class="w-full px-3.5 py-2.5 rounded-md bg-[#faf9f6] border border-zinc-300 text-sm text-zinc-900 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors resize-none"
              ></textarea>
            </div>

            <div
              id="form-error-alert"
              role="alert"
              class="hidden p-3 rounded-md bg-red-50 border border-red-200 text-xs text-red-700"
            ></div>

            <button
              type="submit"
              id="submit-lead-btn"
              class="group w-full relative inline-flex items-center justify-center gap-2.5 py-3.5 rounded-md bg-[#173e2d] hover:bg-[#112e22] border border-[#112e22] text-white font-medium text-sm shadow-sm active:translate-y-0.5 disabled:opacity-60 transition-all cursor-pointer"
            >
              <span id="submit-btn-label">Kirim Formulir Konsultasi</span>
              <svg class="w-4 h-4 text-emerald-200/80 group-hover:text-white transition-all duration-150 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none">
                <path d="M6 3.5L10.5 8L6 12.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </form>

          <div id="form-success-panel" class="hidden space-y-4 py-2">
            <div class="p-4 rounded-md bg-zinc-50 border border-zinc-200 space-y-2">
              <div class="text-sm font-bold text-zinc-900">Formulir Berhasil Terkirim</div>
              <p id="success-summary-text" class="text-xs text-zinc-600 leading-relaxed"></p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <a
                id="success-wa-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="group relative inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-[#173e2d] hover:bg-[#112e22] border border-[#112e22] text-white font-medium text-xs sm:text-sm shadow-sm active:translate-y-0.5 transition-all"
              >
                <span>Lanjut Chat WhatsApp</span>
                <svg class="w-3.5 h-3.5 text-emerald-200/80 group-hover:text-white transition-all duration-150 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none">
                  <path d="M6 3.5L10.5 8L6 12.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

              <a
                href={sandboxSheetUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-white border border-zinc-300 text-zinc-900 font-medium text-xs sm:text-sm shadow-sm hover:bg-[#faf9f6] hover:border-zinc-400 active:translate-y-0.5 transition-all"
              >
                Cek Baris Data di Spreadsheet
              </a>
            </div>

            <button
              type="button"
              id="reset-lead-form-btn"
              class="text-xs text-zinc-500 hover:text-zinc-900 underline pt-2 cursor-pointer"
            >
              Kirim isian baru
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    PACKAGE_LABELS,
    isValidPackageId,
    validateLeadInput
  } from '../utils/validation';

  const wrapper = document.getElementById('lead-form-wrapper');
  const form = document.getElementById('elevate-lead-form') as HTMLFormElement | null;
  const errorAlert = document.getElementById('form-error-alert');
  const submitBtn = document.getElementById('submit-lead-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-btn-label');
  const successPanel = document.getElementById('form-success-panel');
  const successSummary = document.getElementById('success-summary-text');
  const successWaLink = document.getElementById('success-wa-link') as HTMLAnchorElement | null;
  const resetBtn = document.getElementById('reset-lead-form-btn');
  const packageSelect = document.getElementById('packageId') as HTMLSelectElement | null;

  const utmSourceInput = document.getElementById('utm_source') as HTMLInputElement | null;
  const utmMediumInput = document.getElementById('utm_medium') as HTMLInputElement | null;
  const utmCampaignInput = document.getElementById('utm_campaign') as HTMLInputElement | null;
  const referrerInput = document.getElementById('referrer_url') as HTMLInputElement | null;

  const params = new URLSearchParams(window.location.search);
  const utmSource = params.get('utm_source') || 'direct';
  const utmMedium = params.get('utm_medium') || 'none';
  const utmCampaign = params.get('utm_campaign') || 'organic';
  const referrer = document.referrer || 'direct';

  if (utmSourceInput) utmSourceInput.value = utmSource;
  if (utmMediumInput) utmMediumInput.value = utmMedium;
  if (utmCampaignInput) utmCampaignInput.value = utmCampaign;
  if (referrerInput) referrerInput.value = referrer;

  window.addEventListener('elevate:select-package', (event) => {
    const customEvent = event as CustomEvent<{ packageId: string }>;
    const pkgId = customEvent.detail?.packageId;
    if (packageSelect && pkgId && isValidPackageId(pkgId)) {
      packageSelect.value = pkgId;
    }
  });

  function showError(message: string) {
    if (!errorAlert) return;
    errorAlert.textContent = message;
    errorAlert.classList.remove('hidden');
  }

  function clearError() {
    if (!errorAlert) return;
    errorAlert.textContent = '';
    errorAlert.classList.add('hidden');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();

    const formData = new FormData(form);
    const payload = {
      fullName: String(formData.get('fullName') || ''),
      email: String(formData.get('email') || ''),
      phone: String(formData.get('phone') || ''),
      packageId: String(formData.get('packageId') || ''),
      notes: String(formData.get('notes') || ''),
      companyFax: String(formData.get('company_fax') || ''),
      utmSource: String(formData.get('utmSource') || 'direct'),
      utmMedium: String(formData.get('utmMedium') || 'none'),
      utmCampaign: String(formData.get('utmCampaign') || 'organic'),
      referrer: String(formData.get('referrer') || 'direct')
    };

    const check = validateLeadInput(payload);
    if (!check.valid) {
      showError(check.error || 'Periksa kembali kelengkapan data.');
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Mengirim Data...';

    try {
      const response = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = (await response.json()) as { ok: boolean; error?: string };

      if (!response.ok || !result.ok) {
        showError(result.error || 'Terjadi kendala saat mengirim data. Silakan coba kembali.');
        return;
      }

      const selectedPkgLabel = isValidPackageId(payload.packageId)
        ? PACKAGE_LABELS[payload.packageId]
        : payload.packageId;

      if (successSummary) {
        successSummary.textContent = `Terima kasih, ${payload.fullName.trim()}. Permintaan konsultasi untuk ${selectedPkgLabel} telah tercatat di spreadsheet.`;
      }

      const waNumber = wrapper?.getAttribute('data-whatsapp') || '6281234567890';
      const waMessage = encodeURIComponent(
        `Halo SheetFlow, saya ${payload.fullName.trim()} tertarik membuat landing page paket ${selectedPkgLabel}. Mohon info langkah selanjutnya.`
      );
      if (successWaLink) {
        successWaLink.href = `https://wa.me/${waNumber}?text=${waMessage}`;
      }

      form.classList.add('hidden');
      successPanel?.classList.remove('hidden');
    } catch {
      showError('Gagal terhubung ke server. Periksa koneksi internet Anda.');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Kirim Formulir Konsultasi';
    }
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    if (utmSourceInput) utmSourceInput.value = utmSource;
    if (utmMediumInput) utmMediumInput.value = utmMedium;
    if (utmCampaignInput) utmCampaignInput.value = utmCampaign;
    if (referrerInput) referrerInput.value = referrer;
    clearError();
    successPanel?.classList.add('hidden');
    form?.classList.remove('hidden');
  });
</script>
